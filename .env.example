# App
# Cloud Agent から Chrome で確認する場合は localhost:3000（ポート転送後）
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# 開発中のみ。production では無視されます。
# DATABASE_URL が未設定のとき .cursor/start.sh が true にします。
NEXT_PUBLIC_UI_PREVIEW=true

# 追加で許可する origin（カンマ区切り）。Chrome の転送先が localhost 以外のときに使う。
BETTER_AUTH_TRUSTED_ORIGINS=

# Supabase Postgres
# Cursor の Environment Secrets に同じ名前で入れてください。
# Transaction pooler (port 6543) for the app runtime
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection (port 5432) for drizzle-kit migrate / push
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Google OAuth (Better Auth)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
